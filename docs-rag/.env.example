# docs-rag runtime configuration.
#
# ON FASTTRACK THIS FILE IS OPTIONAL — most people never create it.
#   Every variable below also appears in the `environment.envs` block of both
#   pipeline YAMLs. fasttrack_pipeline_inline.yaml ships with all of them filled
#   in at their defaults, so configuring a run means editing one line in the
#   pipeline and uploading nothing.
#
#   Use this file only if you would rather keep settings out of the pipeline
#   definition. Then upload it as `.env` into your model-storage vfolder — the
#   one named in the `mounts:` list of the stage-service task and in
#   PIPELINE_MODEL_STORAGE. Batch tasks see it at /home/work/<folder>, serving
#   containers at /models, and both are searched.
#
# LOCAL DEVELOPMENT
#   Copy to `.env` next to this file (docs-rag/.env). Gitignored.
#
# HOW IT IS LOADED (docs_rag/settings.py:load_layered_dotenv)
#   First hit wins:
#     1. os.environ                    <- values typed into a pipeline YAML's
#                                          envs block, GUI secrets, a shell export
#     2. /models/.env                  <- model storage, as a serving container
#                                          mounts it
#     3. $PIPELINE_MODEL_STORAGE/.env  <- the same vfolder as a batch task mounts
#                                          it, by name under /home/work
#     4. /pipeline/vfroot/.env         <- the auto-created pipeline vFolder
#     5. ./.env                        <- local development
#
#   Layers 2 and 3 are one folder seen from the two container kinds, so a single
#   upload serves both. FastTrack does not pass a deployment node's envs into
#   its container at all, so for the two services a file is the only channel —
#   node 07 writes one into the staging root for exactly that reason.
#
#   "Set" means set to something. A blank value, or an unresolved
#   ${{ secrets.NAME }} placeholder, counts as unset and falls through to the
#   next layer — so a blank line in the YAML never overrides a real value here.
#
# IMPORTANT: put NOTHING after the value on a KEY=VALUE line. Everything after
# the first `=` is the value — inline `# comments` are NOT stripped. Keep
# comments on their own lines, as below.

# --- required ---
# Used by node 03 (embeddings) and node 05 (RAG answers + judge + SemScore).
OPENAI_API_KEY=

# --- optional: alternative LLM endpoint ---
# Point at any OpenAI-compatible server (vLLM, Backend.AI model service, ...).
# Leave empty for api.openai.com.
OPENAI_BASE_URL=
# Chat model used to answer questions.
LLM_MODEL=gpt-4.1
# Embedding model used to build the FAISS indices. Changing this after the
# indices are built requires a full rebuild (node 03).
EMBEDDING_MODEL=text-embedding-3-small
# Qwen-style chain-of-thought. Only applied when OPENAI_BASE_URL is set.
ENABLE_THINKING=false
# Sampling temperature for answers. Low keeps them close to the retrieved text.
TEMPERATURE=0.2
# Cap on answer length.
MAX_TOKENS=4096

# --- optional: indexing (node 03) ---
# Token-based chunking. Changing either needs a full index rebuild.
CHUNK_SIZE=1000
CHUNK_OVERLAP=100

# --- optional: retrieval (nodes 04, 05 and both services) ---
# Chunks pulled from each corpus before pooling.
K_PER_PROJECT=10
# Chunks sent to the model.
GLOBAL_TOP_K=15
# Reciprocal Rank Fusion constant; higher flattens the weighting across ranks.
RRF_K=60
# L2 confidence cutoff, and node 04's canary threshold. The reference run's
# five canaries scored 0.73-0.93 against this.
MAX_L2=1.5
# Truncation per excerpt when building the context.
MAX_CHARS_PER_CHUNK=4000

# --- optional: cloning private doc sources ---
# Only needed if you add a private repo to pipeline/config/sources.yaml. All
# five default sources are public and clone without a token.
GITHUB_TOKEN=

# --- service access credentials (the two deployment nodes) ---
# Leave ALL THREE blank and node 07 generates fresh ones per pipeline run,
# prints them in its task log, and writes them to
# 99_state/service_credentials.json (mode 0600).
#
# Fill ALL THREE to pin them instead. Partial values are ignored on purpose — a
# half-filled login would leave a service half-protected.
#
# Both apps REFUSE TO START with no credentials. Set ALLOW_UNAUTHENTICATED=1 to
# deliberately serve without a login.
# Left blank on purpose: generated credentials are stronger than anything a
# shipped example could suggest, and with open_to_public the services are
# reachable by anyone holding the URL. Fill these in only to pin a known login.
GRADIO_USERNAME=
GRADIO_PASSWORD=
API_KEY=

# --- evaluation (node 05) ---
EVAL_JUDGE_MODEL=gpt-4.1
# Cap the number of fixture questions scored. Unset or 0 = all of them.
EVAL_SAMPLE_SIZE=

# --- FastTrack mount paths ---
# FastTrack sets these per task; listed here so the same .env also drives a
# local run. Leave them commented out locally — with none of them set, every
# stage shares ./pipeline/data and no seeding happens.
# PIPELINE_OUTPUT_ROOT=/pipeline/outputs
# PIPELINE_INPUT_ROOT=/pipeline/input1
# PIPELINE_VFROOT=/pipeline/vfroot
# Where node 07 mirrors the model definitions, the generated .env and the
# credentials. Must match the mounts: entry on the stage-service task.
# PIPELINE_MODEL_STORAGE=/home/work/your_model_folder
